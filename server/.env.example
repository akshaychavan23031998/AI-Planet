# ------------------------------------------------------------
# AI Planet Expense Reimbursement — Backend Environment
# ------------------------------------------------------------
#
# Copy this file to:
#
#   server/.env
#
# for local development.
#
# Never commit server/.env.
# Never expose MONGODB_URI through the frontend or VITE_* variables.
# ------------------------------------------------------------


# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

# Local development:
#   development
#
# Vercel production:
#   production
NODE_ENV=development


# ------------------------------------------------------------
# Local HTTP server
# ------------------------------------------------------------

# Used by the local Express server.
#
# Default:
#   http://localhost:3000
#
# Vercel provides its own runtime port during deployment, so production
# deployment should not depend on a manually configured fixed port.
PORT=3000


# ------------------------------------------------------------
# Frontend origin / CORS
# ------------------------------------------------------------

# Exact frontend origin allowed to call this API.
#
# Local:
#   http://localhost:5173
#
# Production example:
#   https://<frontend-project>.vercel.app
#
# Do not include:
#   - trailing path
#   - query string
#   - wildcard *
#
# Production must be changed to the deployed frontend origin.
CLIENT_ORIGIN=http://localhost:5173


# ------------------------------------------------------------
# MongoDB Atlas
# ------------------------------------------------------------

# Server-side secret.
#
# Use a dedicated least-privilege Atlas application user.
# Recommended permission:
#
#   readWrite on ai_planet_expense
#
# Example only:
#
# mongodb+srv://<username>:<password>@<cluster-host>/
#
# Never commit the real connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/


# Logical MongoDB database used by the application.
MONGODB_DB_NAME=ai_planet_expense


# ------------------------------------------------------------
# Assignment-pack seed only
# ------------------------------------------------------------

# This variable is NOT required during normal application startup.
#
# It is used only when:
#
#   npm run seed
#   npm run test:seed
#
# Prefer setting it only for the command/session instead of storing an
# absolute developer-machine path here.
#
# PowerShell example:
#
#   $env:ASSIGNMENT_PACK_PATH="<path-to-assignment-pack>"
#   npm run seed
#   Remove-Item Env:ASSIGNMENT_PACK_PATH
#
# ASSIGNMENT_PACK_PATH=<path-to-assignment-pack>