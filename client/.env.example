# ------------------------------------------------------------
# AI Planet Expense Reimbursement — Frontend Environment
# ------------------------------------------------------------
#
# Copy this file to:
#
#   client/.env
#
# for local development only if you want to override the default API origin.
#
# VITE_* variables are bundled into the browser.
# Never put secrets, passwords, database URIs or private API keys here.
# ------------------------------------------------------------


# ------------------------------------------------------------
# Backend API origin
# ------------------------------------------------------------

# Local development:
#
#   http://localhost:3000
#
# Vercel production example:
#
#   https://<backend-project>.vercel.app
#
# Requirements:
#
#   - must be http:// or https://
#   - must be an origin only
#   - no path
#   - no query string
#   - no credentials
#
# Example:
#
#   VITE_API_BASE_URL=https://ai-planet-api.vercel.app
#
VITE_API_BASE_URL=http://localhost:3000